# Database
DATABASE_URL=postgresql://scoot:password@localhost:5432/scoot

# Session
SESSION_SECRET=replace_with_64_random_chars

# Default user — seeded automatically on first server start if the users table is empty.
# Required to log in on a fresh machine (public registration is disabled).
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=replace_me
DEFAULT_EMAIL=admin@example.com

# C core socket
SCOOTD_SOCKET=/tmp/scootd.sock

# LLM provider: "anthropic" | "openai_compat"
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5
# For vLLM or other OpenAI-compatible backend:
# LLM_PROVIDER=openai_compat
# LLM_API_URL=http://your-host:8000/v1
# LLM_MODEL=meta-llama/Llama-4-...

# Chat-bot mentions (the @<botname> in-room bot — separate from /bot page)
# Personality and per-bot config live in the `bots` table, not env.
BOT_ENABLED=true
BOT_HISTORY_WINDOW=20
BOT_MAX_REPLY_TOKENS=500
# Search backend for bots with search_enabled=true — scoot-pmp ("Poor Man's
# Perplexity", self-hosted SearXNG + LLM synthesis). Clone as a sibling repo:
# git@github.com:scuzzydude/scoot-pmp.git, run its own docker-compose (SearXNG)
# + its Node HTTP daemon (npm run build && npm start, or a systemd unit).
# From inside this app's container, the host is host.docker.internal.
PMP_URL=http://host.docker.internal:4200
LOG_LEVEL=debug

# Anthropic-compat shim (OpenAI chat/completions -> Anthropic Messages API)
# so scoot-pmp's synthesis step can use this deployment's own Anthropic key
# instead of a separate API account. Leave PMP_SHIM_SECRET blank to disable.
# Host-only (127.0.0.1) — see PMP_SHIM_PORT's port mapping in docker-compose.yml.
PMP_SHIM_PORT=4001
PMP_SHIM_SECRET=

# Data volume root — all persistent data (postgres, media, scootchain) lives here.
# Point this at your data volume mount point in production (e.g. /mnt/data/scoot).
# Defaults to /var/lib/scoot if unset.
DATA_DIR=/var/lib/scoot

# Media
MEDIA_DIR=/var/scoot/media
MEDIA_BASE_URL=http://localhost:3000/media

# Server
PORT=3000
NODE_ENV=development

# Dev phone — messages from this number prefixed with $ are treated as unknown stranger (test mode)
DEV_PHONE=7133055620

# Email (outbound, SMTP) — reuses the same Zoho mailbox/app-password as the
# BigMo mailbox polling section below (IMAP_USER / IMAP_PASSWORD). Leave
# SMTP_HOST blank to disable outbound email.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
# Defaults to IMAP_USER if unset — set only if sending "from" a different address.
SMTP_FROM=

# SMS provider (currently only "twilio")
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public URL Twilio is configured to POST inbound messages to.
# Required behind a reverse proxy so signature validation uses the URL Twilio actually signed.
# Example: https://thedreamlaboratory.org/api/v1/sms/inbound
SMS_INBOUND_URL=
# Set to "true" to echo inbound messages back as a TwiML reply (handy for bidirectional test)
SMS_AUTOREPLY=false
# Set to "true" ONLY during local dev with a tunnel that mangles the URL — skips signature check
TWILIO_SKIP_SIGNATURE=false
# Min gap (ms) between outbound fan-out texts — global throttle to stay under the
# A2P 10DLC long-code ~1 msg/sec ceiling. Lower only with higher-throughput numbers.
SMS_SEND_GAP_MS=1100

# --- BigMo mailbox polling (OPTIONAL) ---
# Periodically checks one IMAP mailbox/folder and texts ROOT_USER_ID (id=1,
# "rocketman") a summary when new mail arrives. Leave IMAP_HOST blank to
# disable — same optional-feature pattern as MEMORY_VAULT_URL below. Use an
# app-specific password (Zoho Mail → Settings → Security → App Passwords),
# not the account's regular login password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# How often to check, in ms. Default 5 minutes.
MAIL_CHECK_INTERVAL_MS=300000

# --- Memory Vault: BigMo long-term semantic memory (OPTIONAL) ---
# Self-hosted Postgres+pgvector memory reached over REST. Leave MEMORY_VAULT_URL
# blank to disable — BigMo then runs on room history alone. When the app runs in
# Docker, use the Memory Vault container's service name on the shared network
# (e.g. http://memory-vault-app-1:8000), not localhost. Create a token with
# `memory-vault token create <name>` (see .claude/memory/infra_memory_vault.md).
MEMORY_VAULT_URL=
MEMORY_VAULT_TOKEN=
# Per-request hard timeout (ms); on timeout BigMo degrades to no memory.
MEMORY_VAULT_TIMEOUT_MS=2500
